# Copy this file to .env and change the values. Never commit real secrets.
PORT=3000
# Long random string used to sign login tokens (required in production)
SECRET=change-me-to-a-long-random-string
# Maximum resume size in megabytes
MAX_RESUME_MB=3
# Folder for db.json and uploads/ (default: project folder)
DATA_DIR=
# LOCAL DEV ONLY: show the password-reset link in the API response (no email service is connected)
DEV_SHOW_RESET_LINK=1
